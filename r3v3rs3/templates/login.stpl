<% let locale = self.preferences.locale; %><!DOCTYPE html>
<html lang="<%= locale.code() %>"<% if let Some(theme) = self.preferences.theme_attribute() { %> data-theme="<%= theme %>"<% } %>>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title><%= locale.t("login.title") %></title>
<% include!("./theme.stpl"); %>
    <style>
        form {
            max-width: 360px;
        }

        h1 {
            margin: 0 0 16px;
            font-size: 22px;
            font-weight: 600;
        }

        label {
            display: block;
            margin-top: 12px;
            font-size: 14px;
            font-weight: 500;
        }

        form .btn {
            width: 100%;
            margin-top: 20px;
        }

        .error {
            margin: 0 0 8px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <form method="post" class="card">
        <h1><%= locale.t("login.title") %></h1>
        <% if let Some(error) = self.error { %>
            <p class="error" role="alert"><%= error %></p>
        <% } %>
        <label for="username"><%= locale.t("login.username") %></label>
        <input class="field" id="username" name="username" type="text" autocomplete="username" autocapitalize="off" value="<%= self.username %>" required<% if self.username.is_empty() { %> autofocus<% } %>>
        <label for="password"><%= locale.t("login.password") %></label>
        <input class="field" id="password" name="password" type="password" autocomplete="current-password" required<% if !self.username.is_empty() { %> autofocus<% } %>>
        <label for="totp"><% if self.totp { %><%= locale.t("login.totp") %><% } else { %><%= locale.t("login.totp_optional") %><% } %></label>
        <input class="field" id="totp" name="totp" type="text" inputmode="numeric" autocomplete="one-time-code"<% if self.totp { %> required<% } %>>
        <input name="redirect" type="hidden" value="<%= self.redirect %>">
        <button class="btn btn-primary" type="submit"><%= locale.t("login.submit") %></button>
        <div class="powered-by">
            <a href="https://github.com/KilimcininKorOglu/r3v3rs3" target="_blank" rel="noopener noreferrer"><%= locale.t("common.powered_by") %></a>
        </div>
    </form>
</body>
</html>
