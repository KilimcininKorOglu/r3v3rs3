<!DOCTYPE html>
<html lang="<%= self.preferences.locale.code() %>"<% if let Some(theme) = self.preferences.theme_attribute() { %> data-theme="<%= theme %>"<% } %>>
<head>
    <meta charset="utf-8">
    <title><%= self.code %> <%= self.text %></title>
    <style>
        :root {
            color-scheme: light;
            --background-color: #f6f6f6;
            --text-color: #303030;
            --link-color: #808080;
        }

        :root[data-theme="dark"] {
            color-scheme: dark;
            --background-color: #121212;
            --text-color: #e0e0e0;
            --link-color: #bbbbbb;
        }

        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                color-scheme: dark;
                --background-color: #121212;
                --text-color: #e0e0e0;
                --link-color: #bbbbbb;
            }
        }

        html {
            background-color: var(--background-color);
            height: 100%;
        }

        body {
            height: 100%;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .error-container {
            text-align: center;
        }

        .error-code, .error-text {
            color: var(--text-color);
        }

        .error-code {
            font-size: 48px;
        }

        .error-text {
            font-size: 24px;
        }

        .powered-by {
            margin-top: 20px;
        }

        .powered-by a {
            font-size: 14px;
            color: var(--link-color);
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-code"><%= self.code %></div>
        <div class="error-text"><%= self.text %></div>
        <div class="powered-by">
            <a href="https://github.com/KilimcininKorOglu/r3v3rs3" target="_blank" rel="noopener noreferrer"><%= self.preferences.locale.t("common.powered_by") %></a>
        </div>
    </div>
</body>
</html>
