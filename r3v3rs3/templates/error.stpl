<!DOCTYPE html>
<html lang="<%= self.preferences.locale.code() %>"<% if let Some(theme) = self.preferences.theme_attribute() { %> data-theme="<%= theme %>"<% } %>>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= self.code %> <%= self.text %></title>
<% include!("./theme.stpl"); %>
    <style>
        .error-container {
            text-align: center;
        }

        .error-code {
            font-size: 48px;
            font-weight: 700;
        }

        .error-text {
            font-size: 22px;
        }

        .request-id {
            margin-top: 16px;
            font-size: 13px;
        }

        .request-id code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            background-color: var(--subtle-color);
            padding: 2px 6px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-code"><%= self.code %></div>
        <div class="error-text"><%= self.text %></div>
        <% if let Some(req_id) = self.request_id { %>
        <div class="request-id muted"><%= self.preferences.locale.t("common.request_id") %>: <code><%= req_id %></code></div>
        <% } %>
        <% if !self.hide_branding { %>
        <div class="powered-by">
            <a href="https://github.com/KilimcininKorOglu/r3v3rs3" target="_blank" rel="noopener noreferrer"><%= self.preferences.locale.t("common.powered_by") %></a>
        </div>
        <% } %>
    </div>
</body>
</html>
