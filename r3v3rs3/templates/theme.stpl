    <style>
        :root {
            color-scheme: light;
            --background-color: #fafafa;
            --panel-color: #ffffff;
            --input-color: #ffffff;
            --subtle-color: #f5f5f5;
            --border-color: #d4d4d4;
            --text-color: #171717;
            --muted-color: #737373;
            --error-color: #dc2626;
            --primary-color: #2563eb;
            --primary-hover-color: #1d4ed8;
            --primary-soft-color: #dbeafe;
            --primary-soft-text-color: #1e40af;
            --secondary-hover-color: #f5f5f5;
        }

        :root[data-theme="dark"] {
            color-scheme: dark;
            --background-color: #333333;
            --panel-color: #262626;
            --input-color: #171717;
            --subtle-color: #404040;
            --border-color: #404040;
            --text-color: #e5e5e5;
            --muted-color: #a3a3a3;
            --error-color: #f87171;
            --primary-soft-color: #1e3a8a;
            --primary-soft-text-color: #bfdbfe;
            --secondary-hover-color: #404040;
        }

        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                color-scheme: dark;
                --background-color: #333333;
                --panel-color: #262626;
                --input-color: #171717;
                --subtle-color: #404040;
                --border-color: #404040;
                --text-color: #e5e5e5;
                --muted-color: #a3a3a3;
                --error-color: #f87171;
                --primary-soft-color: #1e3a8a;
                --primary-soft-text-color: #bfdbfe;
                --secondary-hover-color: #404040;
            }
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            height: 100%;
            background-color: var(--background-color);
        }

        body {
            min-height: 100%;
            margin: 0;
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
            line-height: 1.5;
            color: var(--text-color);
        }

        .card {
            width: 100%;
            padding: 24px;
            background-color: var(--panel-color);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }

        .muted {
            color: var(--muted-color);
        }

        .error {
            color: var(--error-color);
        }

        .field {
            width: 100%;
            margin-top: 4px;
            padding: 8px 10px;
            font: inherit;
            font-size: 14px;
            color: var(--text-color);
            background-color: var(--input-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }

        .field:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.3);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 16px;
            font: inherit;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            text-decoration: none;
        }

        .btn:focus-visible {
            outline: 3px solid rgba(37, 99, 235, 0.4);
            outline-offset: 1px;
        }

        .btn-primary {
            color: #ffffff;
            background-color: var(--primary-color);
        }

        .btn-primary:hover {
            background-color: var(--primary-hover-color);
        }

        .btn-secondary {
            color: var(--text-color);
            background-color: var(--panel-color);
            border-color: var(--border-color);
        }

        .btn-secondary:hover {
            background-color: var(--secondary-hover-color);
        }

        .powered-by {
            margin-top: 16px;
            text-align: center;
        }

        .powered-by a {
            font-size: 12px;
            color: var(--muted-color);
        }
    </style>
