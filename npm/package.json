{
  "name": "r3v3rs3-mcp",
  "version": "1.7.3",
  "description": "A command line MCP client for the r3v3rs3 admin API. This package downloads the prebuilt binary from the GitHub releases of r3v3rs3.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KilimcininKorOglu/r3v3rs3.git",
    "directory": "npm"
  },
  "homepage": "https://r3v3rs3.keremgok.tr/",
  "author": "KilimcininKorOglu <k@keremgok.tr>",
  "bin": {
    "r3v3rs3-mcp": "bin/cli.js"
  },
